{
  "manifest_version": 3,
  "name": "Stillpoint AI — Google Meet Interview Companion",
  "version": "2.0.0",
  "description": "Real-time AI behavioral analysis and candidate telemetry companion for Google Meet interviews.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stillpoint AI Companion"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "sidebar.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
